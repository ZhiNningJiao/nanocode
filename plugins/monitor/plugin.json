{
  "name": "monitor",
  "version": "1.1.0",
  "description": "Fleet monitor: one card per Linear issue + its worktree health. Reads plugins/monitor/lanes.json and pushes plugin:monitor:update events.",
  "enabledByDefault": true,
  "extensionPoints": [
    "host.on",
    "host.registerSetting",
    "host.registerRoute",
    "host.broadcastNotify",
    "host.getSetting",
    "host.registerLifecycle",
    "host.reportStatus",
    "ui.registerPanel",
    "ui.registerSetting",
    "ui.onMessage",
    "ui.fetchSettings",
    "ui.updateSetting"
  ]
}
